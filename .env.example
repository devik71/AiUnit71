# AiUnit71 Configuration
# Copy to .env and fill in your values

# OpenRouter (primary cloud router)
OPENROUTER_API_KEY=

# Direct provider keys (optional - OpenRouter can route to these)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Image generation
MIDJOURNEY_API_KEY=
KREA_API_KEY=
FREEPIK_API_KEY=

# Video generation
KLING_API_KEY=
LUMA_API_KEY=

# Audio
ELEVENLABS_API_KEY=
SUNO_API_KEY=

# Deployment
VERCEL_TOKEN=

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Security
VIRUSTOTAL_API_KEY=

# Human-in-the-Loop
HITL_WEBHOOK_URL=
HITL_DEFAULT_AUTONOMY=1
